          "id": "4884ee20-17ba-4cbe-96ae-6cf001b99301",
          "name": "Amazon Comprehend Delete Document Classifier",
          "request": {
            "name": "Amazon Comprehend Delete Document Classifier",
            "description": {
              "content": "<p>Deletes a previously created document classifier</p> <p>Only those classifiers that are in terminated states (IN_ERROR, TRAINED) will be deleted. If an active inference job is using the model, a <code>ResourceInUseException</code> will be returned.</p> <p>This is an asynchronous action that puts the classifier into a DELETING state, and it is then removed by a background job. Once removed, the classifier disappears from your account and is no longer available for use. </p>",
              "type": "text/plain"
            },
            "url": {
